<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AgroSenseMobile.ViewModels"
             xmlns:models="clr-namespace:AgroSenseMobile.Models"
             xmlns:strings="clr-namespace:AgroSenseMobile.Resources.Localization"
             x:Class="AgroSenseMobile.Views.GreenhousesPage"
             Title="{x:Static strings:AppResources.GreenhousesPageTitle}"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <ContentPage.ToolbarItems>
  
        <ToolbarItem Text="{x:Static strings:AppResources.LogoutButton}" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">


        <RefreshView Grid.Row="0" Margin="15,15,15,0" Command="{Binding LoadGreenhousesCommand}" IsRefreshing="{Binding IsRefreshing}" RefreshColor="#2e7d32">

            <CollectionView ItemsSource="{Binding Greenhouses}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="40">
                        <Path Data="M12 3L4 9v12h16V9l-8-6zm0 2.5l6 4.5v9H6v-9l6-4.5zM12 11c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" Fill="LightGray" Aspect="Uniform" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center"/>
                        <Label Text="{x:Static strings:AppResources.EmptyGreenhouses}" 
                               FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Gray" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Greenhouse">
                        <Frame Margin="0,0,0,15" Padding="15" CornerRadius="12" HasShadow="True" BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=Transparent}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">

                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>

                                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}" CornerRadius="12" Padding="10,5" HasShadow="False" BorderColor="Transparent">
                                    <Label Text="{Binding CropDisplayName}" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                </Frame>

                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="5" Margin="0,15,0,15">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static strings:AppResources.LocationLabel}" TextColor="Gray" VerticalOptions="Center"/>
                                        <Label Text="{Binding Location}" TextColor="Gray" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static strings:AppResources.AreaLabel}" TextColor="Gray" VerticalOptions="Center"/>
                                        <Label Text="{Binding AreaSqMeters}" TextColor="Gray" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label Text="{x:Static strings:AppResources.AreaUnit}" TextColor="Gray" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="15" HorizontalOptions="End" VerticalOptions="Center">
                                    <Grid WidthRequest="40" HeightRequest="40" ToolTipProperties.Text="Відкрити">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GreenhousesViewModel}}, Path=GoToDetailsCommand}" CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>
                                        <RoundRectangle CornerRadius="20" Fill="{AppThemeBinding Light=#E1F5FE, Dark=#01579B}" />
                                        <Path Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" Fill="{AppThemeBinding Light=#0288D1, Dark=#81D4FA}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>

                                    <Grid WidthRequest="40" HeightRequest="40" ToolTipProperties.Text="Редагувати">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GreenhousesViewModel}}, Path=EditGreenhouseCommand}" CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>
                                        <RoundRectangle CornerRadius="20" Fill="{AppThemeBinding Light=#FFF3E0, Dark=#E65100}" />
                                        <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>

                                    <Grid WidthRequest="40" HeightRequest="40" ToolTipProperties.Text="Видалити">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GreenhousesViewModel}}, Path=DeleteGreenhouseCommand}" CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>
                                        <RoundRectangle CornerRadius="20" Fill="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}" />
                                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="{AppThemeBinding Light=#D32F2F, Dark=#EF9A9A}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>

                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ContentView HeightRequest="20" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

     
        <Grid Grid.Row="1" 
              BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
              Padding="25,15,25,30">
           

            <Grid.Shadow>
      
                <Shadow Brush="Black" Offset="0,-4" Opacity="0.08" Radius="10" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="*, Auto, *">

              
                <Grid Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="50" HeightRequest="50">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                    </Grid.GestureRecognizers>

                    <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" 
                          Fill="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" 
                          Aspect="Uniform" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center"/>

                    
                    <Frame CornerRadius="10" BackgroundColor="Red" Padding="0" HasShadow="False"
                           HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0"
                           WidthRequest="20" HeightRequest="20"
                           IsVisible="{Binding HasUnreadNotifications}">
                        <Label Text="{Binding UnreadNotificationsCount}" 
                               TextColor="White" FontSize="10" FontAttributes="Bold" 
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                </Grid>

             
                <Grid Grid.Column="1" VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddGreenhouseCommand}" />
                    </Grid.GestureRecognizers>
                   
                    <RoundRectangle CornerRadius="30" WidthRequest="60" HeightRequest="60" Fill="#2e7d32">
                        <RoundRectangle.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="5" />
                        </RoundRectangle.Shadow>
                    </RoundRectangle>
                  
                    <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" 
                          Fill="White" Aspect="Uniform" WidthRequest="32" HeightRequest="32" 
                          HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

            
                <Grid Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" WidthRequest="50" HeightRequest="50">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                    </Grid.GestureRecognizers>

                 
                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" 
                          Fill="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" 
                          Aspect="Uniform" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>