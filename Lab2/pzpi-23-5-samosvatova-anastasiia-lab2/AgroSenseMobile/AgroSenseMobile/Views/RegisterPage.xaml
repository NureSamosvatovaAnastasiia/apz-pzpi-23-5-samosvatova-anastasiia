<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AgroSenseMobile.ViewModels"
             x:Class="AgroSenseMobile.Views.RegisterPage"
             Title="Реєстрація">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center" MinimumHeightRequest="600">

       
            <VerticalStackLayout Spacing="25">
                <VerticalStackLayout.Triggers>
                
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsVerificationStep}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>

                <Label Text="Створення акаунта" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10"/>

                <Frame Padding="20" CornerRadius="15" HasShadow="True" BackgroundColor="{AppThemeBinding Light=White, Dark=#1e1e1e}" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="15">
                        <Entry Placeholder="Ім'я користувача" Text="{Binding Username}" HeightRequest="50" />
                        <Entry Placeholder="Електронна пошта" Text="{Binding Email}" Keyboard="Email" HeightRequest="50" />
                        <Entry Placeholder="Пароль" Text="{Binding Password}" IsPassword="True" HeightRequest="50" />

                     
                        <Entry Placeholder="Підтвердіть пароль" Text="{Binding ConfirmPassword}" IsPassword="True" HeightRequest="50" />

                        <Button Text="Зареєструватися" 
                                Command="{Binding RegisterCommand}" 
                                BackgroundColor="#2e7d32" 
                                TextColor="White" 
                                CornerRadius="8" 
                                HeightRequest="50" 
                                Margin="0,15,0,0" 
                                FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>


            <VerticalStackLayout Spacing="25" IsVisible="False">
                <VerticalStackLayout.Triggers>
                    
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsVerificationStep}" Value="True">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>

                <Label Text="Підтвердження пошти" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,10"/>

                <Label Text="Введіть код підтвердження, який ми відправили на вашу електронну пошту." 
                       FontSize="15" 
                       HorizontalTextAlignment="Center" 
                       TextColor="Gray" 
                       Margin="0,0,0,10"/>

                <Frame Padding="20" CornerRadius="15" HasShadow="True" BackgroundColor="{AppThemeBinding Light=White, Dark=#1e1e1e}" BorderColor="Transparent">
                    <VerticalStackLayout Spacing="15">
                      
                        <Entry Placeholder="Код підтвердження" 
                               Text="{Binding VerificationCode}" 
                               Keyboard="Numeric" 
                               HeightRequest="50" 
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"
                               FontSize="18"/>

                        <Button Text="Підтвердити" 
                                Command="{Binding VerifyCommand}" 
                                BackgroundColor="#2196F3" 
                                TextColor="White" 
                                CornerRadius="8" 
                                HeightRequest="50" 
                                Margin="0,15,0,0" 
                                FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#2e7d32" HorizontalOptions="Center" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>